{
  "buildCommand": "cd react-app && npm ci && npm run build",
  "outputDirectory": "react-app/build",
  "regions": ["sfo1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "app/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
