{
  "buildCommand": "cd react-app && npm ci && npm run build",
  "outputDirectory": "react-app/build",
  "regions": ["sfo1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "app/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
